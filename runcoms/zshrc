# This needs to be before prezto init because EDITOR is used by zsh-vi-mode to
# set default value of ZVM_VI_EDITOR and then I get nano as the editor with zsh-vi-mode ...
EMACS=emacs
EMACSCLIENT=emacsclient
export VISUAL="$EMACSCLIENT -t"
export EDITOR="$VISUAL"
alias em="$EMACSCLIENT -c -a $EMACS"
alias ec="$EMACSCLIENT -c"

# Initialise zsh-vi-mode when the script is sourced rather than when the first
# command line starts This avoids messing up shortcuts like C-r defined by
# atuin, see:
# https://github.com/jeffreytse/zsh-vi-mode?tab=readme-ov-file#initialization-mode
# I also put zsh-vi-mode last in zpreztorc plugins load to try that zsh-vi-mode
# has the last word
ZVM_INIT_MODE=sourcing

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
fi

# Improve vi insert mode shortcut by adding a few emacs convenient shortcuts
# bindkey -M emacs shows all the emacs shortcuts if needed
bindkey -M viins '^p' history-substring-search-up
bindkey -M viins '^n' history-substring-search-down
bindkey -M viins "^[p" history-beginning-search-backward
bindkey -M viins "^[n" history-beginning-search-forward
bindkey -M viins "^k" kill-line
bindkey -M viins "^u" kill-whole-line
bindkey -M viins "^[." insert-last-word
bindkey -M viins "^a" beginning-of-line
bindkey -M viins "^d" delete-char
bindkey -M viins "^h" backward-delete-char
bindkey -M viins "^[d" kill-word
bindkey -M viins "^[^?" backward-kill-word
bindkey -M viins "^[f" forward-word
bindkey -M viins "^[b" backward-word
bindkey -M viins "^x^e" edit-command-line
# For some reason typing ESC waits too long before entering into command mode.
# In an ideal world this should be handled by ZVM_ESCAPE_KEYTIMEOUT but it
# looks like it isn't? I don't use keychords too much so setting a smaller
# general timeout seems fine (default is 0.4)
export ZVM_KEYTIMEOUT=0.1

# Customize to your needs...
# IPython debugger in pytest
alias pytestdb='pytest --pdb --pdbcls=IPython.terminal.debugger:TerminalPdb --capture no'
# Make sure pytest adds current directory to sys.path
alias pytest='python -m pytest'
alias _pytest='command pytest'

# alias for managing dotfiles with stow
DOTFILES_DIR=~/dev/dotfiles
alias dotfiles-stow="stow --target ~ --dir $DOTFILES_DIR -S ."
alias dotfiles-restow="dotfiles-stow -R"
# useful to run dotfiles st from any folder
alias dotfiles="git -C $DOTFILES_DIR"

# Taken from https://remysharp.com/2018/08/23/cli-improved
alias preview="fzf --preview 'bat --color \"always\" {}'"
# alias to avoid typing password when sshing to aiglon. Somehow even if SSH
# keys are set, it asks password (random guess: maybe a pam thing to renew the
# kerberos ticket ...)
alias aiglon='SSHPASS=$(pass work/inria/main | head -n1) sshpass -e ssh aiglon '
# alias to avoid typing password for adastra
alias adastra='SSHPASS=$(pass work/cines | head -n1) sshpass -e ssh adastra'

# Make vim surround in terminal more similar to evil (although a bit different
# for example sa" rather than s" to quote selection)
ZVM_VI_SURROUND_BINDKEY='s-prefix'

# terminal 256 color support
if [[ "$TERM" == "xterm" ]]; then
    export TERM="xterm-256color"
fi
if [[ "$TERM" == "screen" ]]; then
    export TERM="screen-256color"
fi

# Magically link PYTHONPATH to the ZSH array pythonpath
typeset -T PYTHONPATH pythonpath
# Remove duplicates
typeset -U pythonpath path
export PYTHONPATH pythonpath

# Alias to have help for bash builtins
function help() {
    bash --norc -c "help $1"
}

# Prepending custom paths
# join function from http://stackoverflow.com/a/17841619
function join_by { local IFS="$1"; shift; echo "$*"; }

CCACHE_PATH="/usr/lib/ccache/bin"
MY_BIN_PATH="$HOME/bin"
PIXI_PATH="$HOME/.pixi/bin"
# export PATH=/home/lesteve/.pixi/bin:$PATH
PATHS_TO_PREPEND=$(join_by ':' $CCACHE_PATH $MY_BIN_PATH $PIXI_PATH)

if [ -n "$PATHS_TO_PREPEND" ]; then
    export PATH="$PATHS_TO_PREPEND:$PATH"
fi

if [ -n "$PATHS_TO_APPEND" ]; then
    export PATH="$PATH:$PATHS_TO_APPEND"
fi

# Switches the mouse handedness using the command line rather than
# going via system setting
function mouse-switch() {
    handedness=$1
    shift
    case $handedness in
        left|l)
            xmodmap -e 'pointer = 3 2 1'
            return $?
            ;;
        right|r)
            xmodmap -e 'pointer = 1 2 3'
            return $?
            ;;
        *)
            echo "Argument should be one of 'left, l, right, l'"
            return 1
            ;;
    esac
}

# Make * match files starting with .
setopt globdots

# prompt_subst is needed otherwise PS1 is not interpreted with starship prompt
# e.g. looks like $(somme-command-that-returns-ps1). From
# https://github.com/sorin-ionescu/prezto/issues/1887#issuecomment-1040761561
setopt prompt_subst

# Set up fzf completions and shortcuts
FZF_SHARE=/usr/share/fzf
if [[ -d $FZF_SHARE ]]; then
    source $FZF_SHARE/completion.zsh
    source $FZF_SHARE/key-bindings.zsh
fi

# Easy way to have pass ** use fzf for password completion
_fzf_complete_pass() {
  ARGS="$@"
  _fzf_complete '' "$@" < <(
    command find ~/.password-store/ -name "*.gpg" | sed -r 's,(.*)\.password-store/(.*)\.gpg,\2,'
  )
}

# Need this to make sure module command available
# on some HPC clusters
if [[ -d $MODULESHOME ]]; then
    source $MODULESHOME/init/zsh
fi

# Useful functions to start/stop syncthing both locally and remotely
function start_syncthing {
  tmux new -s syncthing -d
  tmux send-keys -t syncthing 'killall syncthing' C-m
  tmux send-keys -t syncthing syncthing C-m
  tmux split-window -h -t syncthing
  # the echo is a hack. Not 100% sure but it seems like the password gets into
  # the command when no password is asked. Without the echo the killall gets an
  # error showing the help.
  tmux send-keys -t syncthing \
       'SSHPASS=$(pass work/inria/main | head -n1) \
        sshpass -e ssh aiglon bash -c \
            "echo > /dev/null; killall syncthing; ~/bin/syncthing --no-browser"' C-m
}

function stop_syncthing {
  for i in 0 1; do
    tmux select-pane -t $i
    tmux send-keys -t syncthing C-c
    tmux send-keys -t syncthing C-d
  done
  tmux kill-session -t syncthing
}

# Allow ssh-agent connection started with systemctl --user enable ssh-agent.service
# See https://wiki.archlinux.org/title/SSH_keys#Start_ssh-agent_with_systemd_user
export SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/ssh-agent.socket

# init zoxide to jump quicker to used folders
eval "$(zoxide init zsh)"

# atuin for better C-r
eval "$(atuin init zsh --disable-up-arrow)"

# pixi completions
eval "$(pixi completion --shell zsh)"

# >>> mamba initialize >>>
# !! Contents within this block are managed by 'micromamba shell init' !!
export MAMBA_EXE='/home/lesteve/.local/bin/micromamba';
export MAMBA_ROOT_PREFIX='/home/lesteve/micromamba';
__mamba_setup="$("$MAMBA_EXE" shell hook --shell zsh --root-prefix "$MAMBA_ROOT_PREFIX" 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__mamba_setup"
else
    alias micromamba="$MAMBA_EXE"  # Fallback on help from micromamba activate
fi
unset __mamba_setup
# <<< mamba initialize <<<

# micromamba aliases
alias mamba='micromamba'
alias _mamba='command mamba'
function ma() {
  old_conda_env=$CONDA_DEFAULT_ENV
  micromamba deactivate && micromamba activate $1 || micromamba activate $old_conda_env
}
# Make ma tab completion work. Inspired from echo $__mamba_setup without a deep
# understanding ... I did not manage to use compdef to tell ma to use the same
# completions as micromamba activate. It works with a command but not with command + arg
function _ma() {
  COMPREPLY=($(__mamba_exe completer activate "${(@s: :)${(@s: :)COMP_LINE}:1}"))
}
complete -o default -F _ma ma
alias mda='micromamba deactivate'
# activate base environment
micromamba activate

# Added by LM Studio CLI (lms)
export PATH="$PATH:/home/lesteve/.cache/lm-studio/bin"

